# ==============================================================================
# DAFTAR API KEY AI 100% GRATIS (TANPA KARTU KREDIT) — POHON PENGETAHUAN
# Salin file ini menjadi .env (otomatis diabaikan Git).
# Anda cukup isi 1 atau beberapa key saja; jika satu penyedia mencapai batas
# kuota harian (HTTP 429), sistem OTOMATIS pindah ke penyedia gratis berikutnya!
# Tanpa API key sama sekali pun, sistem tetap berjalan di Mode Lokal (0 biaya).
# ==============================================================================

# 1. Google AI Studio (Gemini 3.5 Flash-Lite) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Groq (Super Cepat · Llama 3.3 70B & 8B) — https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter (Meta-Router :free) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. Mistral AI (La Plateforme Free Tier) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# 5. Cerebras Inference (Wafer-Scale) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# 6. NVIDIA NIM (Developer Prototyping Gratis) — https://build.nvidia.com/
NVIDIA_API_KEY=
